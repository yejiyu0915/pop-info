# Server
PORT=3000
NODE_ENV=development

# Database (로컬 MySQL — Docker 불필요)
# 1) MySQL 설치 후 scripts/init-db.sql 실행
# 2) 아래 URL을 본인 환경에 맞게 수정
#
# 전용 유저 (init-db.sql 기준):
DATABASE_URL="mysql://popup_user:popup_password@localhost:3306/popup_db"
#
# root 사용 시:
# DATABASE_URL="mysql://root:YOUR_ROOT_PASSWORD@localhost:3306/popup_db"

# CORS
CORS_ORIGIN=http://localhost:5173

# JWT (production: 최소 32자 이상의 랜덤 값 사용)
JWT_SECRET=replace-this-with-a-long-random-secret-before-production
JWT_EXPIRES_IN=7d

# Email option 1: Gmail SMTP (no custom domain needed for this small assignment deployment)
# Create a dedicated Google account, enable 2-Step Verification, then create an App Password.
# Never commit or share the app password. Set these only in .env on the server.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=popcast.auth@gmail.com
# SMTP_PASS=your-16-character-google-app-password
# SMTP_FROM="POPCAST <popcast.auth@gmail.com>"

# Email option 2: Resend (requires a verified sender domain for external recipients)
# RESEND_API_KEY=re_xxxxxxxxx
# EMAIL_FROM="POPCAST <noreply@your-domain.com>"

# Docker production deployment (docker compose -f docker-compose.prod.yml up -d --build)
# DOMAIN=popup.example.com
# MYSQL_DATABASE=popup_db
# MYSQL_USER=popup_user
# MYSQL_PASSWORD=use-a-long-unique-database-password
# MYSQL_ROOT_PASSWORD=use-another-long-unique-root-password

# --- 프로덕션 예시 ---
# NODE_ENV=production
# CORS_ORIGIN=http://YOUR_SERVER_IP:5173
# CORS_ORIGIN=https://your-frontend-domain.com
# DATABASE_URL="mysql://popup_user:password@localhost:3306/popup_db"
# JWT_SECRET=strong-random-secret-for-production
